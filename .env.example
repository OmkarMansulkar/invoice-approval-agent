# Copy this file to .env and fill in real values before running.

# --- LLM provider ---
# Set which provider the extractor agent should call. Options: groq, openai, mock
LLM_PROVIDER=mock
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_openai_key_here
LLM_MODEL=llama-3.1-8b-instant

# --- Database ---
DATABASE_URL=sqlite:///./invoice_agent.db

# --- API auth (very simple header-based key check via middleware) ---
API_KEY=demo-secret-key

# --- Demo / interview safety net ---
# If true, the extractor agent skips the real LLM call and uses a deterministic
# parser instead. Keeps the demo working even with no internet/API key on-site.
MOCK_MODE=true
